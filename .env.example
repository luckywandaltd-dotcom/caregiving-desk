# All NEXT_PUBLIC variables are embedded in browser code at build time.
# Never paste API keys, access tokens, passwords, or other secrets here.

# Replace with the actual public HTTPS site origin before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional email provider: use its public subscription form action, not its API.
# Leave empty to show an honest unavailable state while the provider is unset.
NEXT_PUBLIC_EMAIL_FORM_ACTION_URL=
# "native" POSTs to the provider and uses its confirmation page (default).
# "json" requires a CORS-enabled endpoint accepting JSON and returning 2xx JSON
# with {"ok":true} or {"success":true} and no error/errors on accepted submissions.
NEXT_PUBLIC_EMAIL_FORM_MODE=native
# Examples: email (default), email_address (some ConvertKit forms), fields[email]
# (some MailerLite forms). Check the actual provider form's documented contract.
NEXT_PUBLIC_EMAIL_FIELD_NAME=email
# Optional fallback hosted signup page or a free Gumroad product URL. Used if no
# form action is set. Helpful when a provider requires its own hidden fields.
NEXT_PUBLIC_EMAIL_SIGNUP_URL=

# Optional public contact endpoint, for example https://formspree.io/f/YOUR_FORM_ID.
# Must accept cross-origin JSON POSTs and return 2xx JSON with {"ok":true} or
# {"success":true}, without error/errors, only for accepted messages.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional HTTPS override for the free printable. Empty or invalid values use
# /downloads/parents-care-information-printable.pdf, the supplied two-page A4 PDF.
# The default download is public and requires no signup; email signup is separate.
NEXT_PUBLIC_FRIDGE_SHEET_URL=

# Analytics are optional, off by default, and loaded only after visitor consent.
# Set only one provider. For Plausible, enter the configured domain without https://.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# For Google Analytics, use the public G-... measurement ID, never an API secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
